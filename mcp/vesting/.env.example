# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials, and this file itself
# gets rsynced straight to prod by `npm run deploy`. Do NOT add NODE_ENV
# here (same convention as mcp/stormwater); `npm run dev` sets it inline.

MCP_HOST=https://api.franklin-gov.com
MCP_PORT=7004

# Shared secret required as the `X-MCP-Key` header on every request to the
# raw MCP endpoint (POST/GET/DELETE /vesting) — see mcp/vesting/README.md's
# Security section. Not used by /vesting/chat, which is Entra-gated instead.
# Generate with: openssl rand -hex 32
MCP_API_KEY=

# Vesting SQL Server connection — authenticate as the `claude` SQL login,
# whose default schema is `claude` and which should only ever have SELECT
# granted on that schema's views (see mcp/vesting/README.md).
VESTING_DB_SERVER=
VESTING_DB_DATABASE=
VESTING_DB_USER=claude
VESTING_DB_PASSWORD=

# Entra ID (Azure AD) — same app registration/tenant eng-api-ts validates
# against, so the frontend can send the same bearer token it already
# acquires for the main API.
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=

# Anthropic API key for the /vesting/chat agent loop.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — CivicClerk (public meetings) API base URL, no auth required.
# Defaults to https://franklintn.v8.civicclerk.com if unset. See
# mcp/vesting/README.md's "CivicClerk integration" section.
CIVICCLERK_BASE_URL=
