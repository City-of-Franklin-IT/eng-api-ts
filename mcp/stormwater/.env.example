# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials, and this file itself
# gets rsynced straight to prod by `npm run deploy` — do NOT add NODE_ENV
# here. `npm run dev` sets NODE_ENV=development inline (same convention as
# eng-api-ts's own root .env/package.json), which bypasses Entra auth on
# /stormwater/chat with a mock user. This file must stay production-safe.

MCP_HOST=https://api.franklin-gov.com
MCP_PORT=7003

# Stormwater SQL Server connection — authenticate as the `claude` SQL login,
# whose default schema is `claude` and which should only ever have SELECT
# granted on that schema's views (see mcp/stormwater/README.md).
STORMWATER_DB_SERVER=
STORMWATER_DB_DATABASE=
STORMWATER_DB_USER=claude
STORMWATER_DB_PASSWORD=

# Entra ID (Azure AD) — same app registration/tenant eng-api-ts validates
# against for the stormwater routes, so the frontend can send the same
# bearer token it already acquires for the main API.
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=

# Anthropic API key for the /stormwater/chat agent loop.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5
