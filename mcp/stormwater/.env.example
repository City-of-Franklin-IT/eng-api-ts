# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

MCP_HOST=https://api.franklin-gov.com
MCP_PORT=7003

# Stormwater SQL Server connection — authenticate as the `claude` SQL login,
# whose default schema is `claude` and which should only ever have SELECT
# granted on that schema's views (see mcp/stormwater/README.md).
STORMWATER_DB_SERVER=
STORMWATER_DB_DATABASE=
STORMWATER_DB_USER=claude
STORMWATER_DB_PASSWORD=
