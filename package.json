{
  "name": "eng-api-ts",
  "version": "1.0.0",
  "description": "Express app handles database actions for Engineering related applications",
  "main": "app.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "NODE_ENV=development nodemon -r tsconfig-paths/register src/app.ts",
    "deploy": "rsync -av --delete dist/ andrew@cofasv30:/opt/builds/eng-api-ts/dist/ && rsync -av package.json package-lock.json .env .env.production andrew@cofasv30:/opt/builds/eng-api-ts/ && ssh andrew@cofasv30 'pm2 restart eng-api-ts'",
    "start": "NODE_ENV=production npx tsx dist/app.js"
  },
  "author": "Andrew Southern",
  "license": "ISC",
  "dependencies": {
    "@types/cors": "^2.8.17",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sequelize": "^6.37.5",
    "sharp": "^0.33.5",
    "tedious": "^18.6.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/helmet": "^0.0.48",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.6",
    "@types/nodemailer": "^6.4.17",
    "nodemon": "^3.1.9",
    "pino-pretty": "^11.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
