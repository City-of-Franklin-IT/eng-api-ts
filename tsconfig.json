{
  "compilerOptions": {
    "target": "ES2020",                                 // Modern Node.js supports recent ECMAScript features
    "module": "node16",                               // Node.js uses CommonJS by default
    "rootDir": "./src",                                 // Where your TypeScript files live
    "outDir": "./dist",                                 // Where your compiled JavaScript will go
    "esModuleInterop": true,                            // Enables compatibility with CommonJS modules
    "strict": true,                                     // Enables strict type checking
    "skipLibCheck": true,                              // Skip type checking of declaration files
    "forceConsistentCasingInFileNames": true,           // Ensures consistent casing of file names
    "moduleResolution": "node16",                         // Use Node.js style module resolution
    "resolveJsonModule": true,                          // Allows importing JSON files
    "sourceMap": true,                                  // Generates source maps for debugging
    "typeRoots": [
      "./src/@types", 
      "./node_modules/@types"
    ],
    "paths": {
      "@config": ["./src/config/*"],
      "@controllers/*": ["./src/controllers/*"],
      "@middleware/*": ["./src/middleware/*"],
      "@models/*": ["./src/models/*"],
      "@routes/*": ["./src/routes/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",                                     // What to ignore
    "dist"
  ]
}